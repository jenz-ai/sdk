{
  "name": "@jenz-ai/sdk",
  "version": "1.0.0",
  "description": "Core client SDK for Jenz — observability for AI agents (runs, events, costs, latency).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jenz-ai/sdk/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenz-ai/sdk.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/jenz-ai/sdk/issues",
  "keywords": [
    "ai",
    "agent",
    "observability",
    "tracing",
    "llm",
    "telemetry",
    "jenz"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.2",
    "@types/node": "^22.9.0",
    "hono": "^4.12.18",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.5"
  }
}
