{
  "name": "@jenz-ai/claude-agent-sdk",
  "version": "0.1.0",
  "description": "Zero-config Claude Agent SDK adapter for Jenz observability.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jenz-ai/sdk/tree/main/packages/claude-agent-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenz-ai/sdk.git",
    "directory": "packages/claude-agent-sdk"
  },
  "bugs": "https://github.com/jenz-ai/sdk/issues",
  "keywords": [
    "ai",
    "agent",
    "observability",
    "anthropic",
    "claude",
    "claude-agent",
    "tracing",
    "jenz"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jenz-ai/sdk": "workspace:^"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@hono/node-server": "^2.0.2",
    "@types/node": "^22.9.0",
    "hono": "^4.12.18",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.5"
  }
}
