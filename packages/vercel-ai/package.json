{
  "name": "@jenz-ai/vercel-ai",
  "version": "0.1.2",
  "description": "Zero-config Vercel AI SDK wrapper for Jenz observability.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jenz-ai/sdk/tree/main/packages/vercel-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenz-ai/sdk.git",
    "directory": "packages/vercel-ai"
  },
  "bugs": "https://github.com/jenz-ai/sdk/issues",
  "keywords": [
    "ai",
    "agent",
    "observability",
    "vercel-ai",
    "vercel",
    "tracing",
    "jenz"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jenz-ai/sdk": "workspace:^"
  },
  "peerDependencies": {
    "ai": ">=5.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@types/node": "^22.9.0",
    "ai": "^6.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.5"
  }
}
